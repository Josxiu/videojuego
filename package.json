{
  "name": "trasnocho",
  "private": true,
  "version": "1.0.0",
  "description": "Trasnocho — el último tren nocturno y los sueños de sus pasajeros",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node tools/smoke-test.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/monoton": "^5.3.0",
    "@fontsource/sancreek": "^5.3.0",
    "@fontsource/yellowtail": "^5.3.0",
    "phaser": "^3.90.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.187.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
